# Copy to .env for local development
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signing key for access tokens. REQUIRED in production (min 32 characters):
#   openssl rand -hex 32
# In development it may be left empty; a random key is generated per start.
JWT_SECRET=

# Number of reverse proxies in front of the API. Set to 1 behind Nginx so rate
# limiting sees the real client address instead of the proxy's.
TRUST_PROXY=0

# ── Barcode lookup ───────────────────────────────────────────────────────────
# Open Food Facts asks each client to identify itself: "AppName/Version (contact URL or email)"
# OFF_USER_AGENT="NutritionTracker/1.0 (https://yourdomain.com)"

# ── Email (password reset) ───────────────────────────────────────────────────
# Leave RESEND_API_KEY empty in development: emails are printed to the server
# log instead of sent, so you can copy the reset link from there.
RESEND_API_KEY=
MAIL_FROM="Nutrition Tracker <no-reply@yourdomain.com>"

# Link placed in reset emails; {token} is replaced. Defaults to
# FRONTEND_URL/reset-password?token={token}. Use an app deep link for mobile.
# PASSWORD_RESET_URL=myapp://reset-password?token={token}
