{
  "name": "@nutrition/web",
  "version": "1.0.0",
  "description": "Katarina's Nutrition Tracker \u2014 React + TypeScript + Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "npm run build -w @nutrition/shared"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@nutrition/shared": "*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "vitest": "^2.1.9"
  },
  "private": true
}
